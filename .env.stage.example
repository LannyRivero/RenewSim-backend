# Stage / showcase environment example
# Copy to `.env.stage` and replace placeholder values.

STAGE_MYSQL_ROOT_PASSWORD=change-me
STAGE_MYSQL_DATABASE=renewsim
STAGE_MYSQL_USER=renewsim
STAGE_MYSQL_PASSWORD=change-me

OPENWEATHER_API_KEY=change-me
OPENWEATHER_BASE_URL=https://api.openweathermap.org

SECURITY_JWT_SECRET_BASE64=change-me
SECURITY_JWT_ISSUER=renewsim-auth-stage
SECURITY_JWT_AUDIENCE=renewsim-app-stage

APP_FRONTEND_URL=http://localhost:3000
APP_EMAIL_VERIFICATION_EXPIRATION_HOURS=48
APP_PORT=8080
