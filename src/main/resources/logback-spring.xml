<configuration scan="true" scanPeriod="60 seconds">

    <!-- Paths -->
    <property name="LOG_DIR" value="${SPRING_LOG_DIR:-logs}"/>
    <property name="LOG_FILE" value="${LOG_DIR}/application.log"/>

    <!-- Pattern (ISO-8601 + MDC traceId con fallback + stacktrace) -->
<property name="LOG_PATTERN"
          value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{36} traceId=%X{traceId:-N/A} user=%X{username:-N/A} roles=%X{roles:-N/A} ip=%X{ip:-N/A} path=%X{path:-N/A} - %msg%n%ex{full}"/>

    <!-- Console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- File rolling diario + compresión + tope -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/application-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Async wrappers -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>16384</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- Loggers base -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="com.renewsim" level="DEBUG"/>

    <!-- DEV / LOCAL -->
    <springProfile name="dev,local">
        <!-- Patrón con colores solo para consola en dev/local -->
        <appender name="CONSOLE_DEV" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36})
                    traceId=%X{traceId:-N/A} - %msg%n%ex{full}</pattern>
            </encoder>
        </appender>
        <appender name="ASYNC_CONSOLE_DEV" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>8192</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
            <appender-ref ref="CONSOLE_DEV"/>
        </appender>

        <logger name="org.hibernate.SQL" level="DEBUG"/>

        <root level="DEBUG">
            <appender-ref ref="ASYNC_CONSOLE_DEV"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- Otros perfiles (test, prod, etc.) -->
    <springProfile name="!dev,!local">
        <root level="INFO">
            <appender-ref ref="ASYNC_CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- Auditoría de autenticación -->
    <appender name="AUTH_AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/auth-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/auth-audit-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level traceId=%X{traceId:-N/A} - %msg%n%ex{full}</pattern>
        </encoder>
    </appender>

    <logger name="AUTH_AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUTH_AUDIT_FILE"/>
    </logger>

</configuration>




